# Sovereign-Scan Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# OpenAI API Key (required if USE_OLLAMA=false)
OPENAI_API_KEY=sk-your-api-key-here

# Use Ollama local instance instead of OpenAI
# Set to "true" to use local Ollama, "false" or leave empty for OpenAI
USE_OLLAMA=false

# Ollama configuration (only used when USE_OLLAMA=true)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3